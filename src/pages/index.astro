---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
}))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <p class="kicker">Delphi • Object Pascal • VCL • FireDAC</p>
        <h1>Practical Delphi. Real-World Code. Every Day.</h1>
        <p>
          A clean, independent publication for Delphi developers building real business applications,
          native Windows tools, database systems, and production-grade software.
        </p>

        <div class="button-row">
          <a class="button primary" href="/blog/">Start reading</a>
          <a class="button secondary" href="/about/">About the blog</a>
        </div>
      </div>

      <aside class="hero-card">
        <strong>Clean by design.</strong>
        <p>
          Medium-style reading, Astro speed, Markdown content, RSS, sitemap, and working Pascal code highlighting.
        </p>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Latest posts</h2>
        <a href="/blog/">View all</a>
      </div>

      <div class="post-feed">
        {
          posts.map((post) => (
            <article class="post-row">
              <div>
                <a href={`/blog/${post.id}/`}>
                  <h3>{post.data.title}</h3>
                </a>
                <p>{post.data.description}</p>
                <div class="post-meta">
                  <span>{post.data.pubDate.toLocaleDateString('en-US')}</span>
                  <span>•</span>
                  <span>{post.data.author}</span>
                </div>
              </div>

              <div class="post-tags">
                {post.data.tags.slice(0, 3).map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
